            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/fotografos/{id}": {
      "get": {
        "summary": "Perfil publico do fotografo",
        "tags": [
          "Vitrine"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/estudio/resumo": {
      "get": {
        "summary": "Indicadores do fotografo",
        "tags": [
          "Estudio"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/estudio/vendas": {
      "get": {
        "summary": "Vendas (com o liquido apos a taxa)",
        "tags": [
          "Estudio"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "pagina",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "tamanhoPagina",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/estudio/perfil": {
      "put": {
        "summary": "Atualiza o perfil publico, a chave Pix (guardada cifrada) e a conta PagBank que recebe a parte do fotografo (split)",
        "tags": [
          "Estudio"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nomeArtistico": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "bio": {
                    "type": "string",
                    "maxLength": 1000,
                    "nullable": true
                  },
                  "cidade": {
                    "type": "string",
                    "maxLength": 80,
                    "nullable": true
                  },
                  "estado": {
                    "type": "string",
                    "maxLength": 2,
                    "nullable": true
                  },
                  "especialidade": {
                    "type": "string",
                    "maxLength": 80,
                    "nullable": true
                  },
                  "pixChave": {
                    "type": "string",
                    "maxLength": 77,
                    "nullable": true
                  },
                  "pagbankContaId": {
                    "type": "string",
                    "maxLength": 41,
                    "nullable": true
                  },
                  "versao": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/estudio/fotos": {
      "post": {
        "summary": "Publica uma foto (multipart: arquivo, titulo, precoCentavos, descricao, tags, eventoId). Gera preview com marca d'agua e cifra o original.",
        "tags": [
          "Estudio"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "get": {
        "summary": "Minhas fotos",
        "tags": [
          "Estudio"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "pagina",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "tamanhoPagina",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "publicada",
                "oculta"
              ]
            },
            "in": "query",
            "name": "status",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "in": "query",
            "name": "q",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "query",
            "name": "eventoId",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/estudio/fotos/{id}": {
      "patch": {
        "summary": "Edita titulo, preco, tags, evento ou visibilidade",
        "tags": [
          "Estudio"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": {
                    "type": "string",
                    "maxLength": 150
                  },
                  "descricao": {
                    "type": "string",
                    "maxLength": 1000,
                    "nullable": true
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 30
                    },
                    "maxItems": 20
                  },
                  "precoCentavos": {
                    "type": "integer"
                  },
                  "eventoId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "publicada",
                      "oculta"
                    ]
                  },
                  "versao": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "delete": {
        "summary": "Exclui (definitiva sem vendas; arquivada se ja vendida)",
        "tags": [
          "Estudio"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/estudio/eventos": {
      "get": {
        "summary": "Meus eventos",
        "tags": [
          "Estudio"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "pagina",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "tamanhoPagina",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "summary": "Cria evento",
        "tags": [
          "Estudio"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "titulo",
                  "dataEvento"
                ],
                "properties": {
                  "titulo": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 150
                  },
                  "descricao": {
                    "type": "string",
                    "maxLength": 1000,
                    "nullable": true
                  },
                  "local": {
                    "type": "string",
                    "maxLength": 150,
                    "nullable": true
                  },
                  "dataEvento": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/estudio/eventos/{id}": {
      "patch": {
        "summary": "Edita evento",
        "tags": [
