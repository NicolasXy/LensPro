{
  "openapi": "3.0.3",
  "info": {
    "title": "LensPro API",
    "description": "Marketplace de fotografias com marca d'agua",
    "version": "2.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Verifica se a API esta no ar",
        "tags": [
          "Sistema"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/cadastro": {
      "post": {
        "summary": "Cria conta de comprador ou fotografo e ja devolve o token",
        "tags": [
          "Autenticacao"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "sobrenome",
                  "email",
                  "senha",
                  "tipo"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "sobrenome": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 150
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72
                  },
                  "tipo": {
                    "type": "string",
                    "enum": [
                      "comprador",
                      "fotografo"
                    ]
                  },
                  "nomeArtistico": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login: devolve JWT (30 min)",
        "tags": [
          "Autenticacao"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "senha"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 150
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/recuperar-senha": {
      "post": {
        "summary": "Pede o link de recuperacao (resposta sempre igual)",
        "tags": [
          "Autenticacao"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 150
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/redefinir-senha": {
      "post": {
        "summary": "Define a nova senha com o token do link",
        "tags": [
          "Autenticacao"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "novaSenha"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 100
                  },
                  "novaSenha": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/sair": {
      "post": {
        "summary": "Encerra a sessao do navegador (apaga o cookie HttpOnly)",
        "tags": [
          "Conta"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/renovar": {
      "post": {
        "summary": "Renova o token (sessao deslizante de 30 min por inatividade)",
        "tags": [
          "Conta"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/eu": {
      "get": {
        "summary": "Dados da conta logada (e perfil, se fotografo)",
        "tags": [
          "Conta"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "patch": {
        "summary": "Altera nome e sobrenome",
        "tags": [
          "Conta"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "sobrenome": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "versao": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/senha": {
      "put": {
        "summary": "Troca a propria senha",
        "tags": [
          "Conta"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "senhaAtual",
                  "novaSenha"
                ],
                "properties": {
                  "senhaAtual": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "novaSenha": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/contato": {
      "post": {
        "summary": "Formulario Fale conosco",
        "tags": [
          "Contato"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "email",
                  "mensagem"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 150
                  },
                  "mensagem": {
                    "type": "string",
                    "maxLength": 3000
                  },
                  "site": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Campo-isca anti-robo: deve ficar vazio."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/fotos": {
      "get": {
        "summary": "Lista fotos publicadas (somente previews com marca d'agua)",
        "tags": [
          "Vitrine"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "pagina",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "tamanhoPagina",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "in": "query",
            "name": "q",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 30
            },
            "in": "query",
            "name": "tag",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "query",
            "name": "eventoId",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "query",
            "name": "fotografoId",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "recentes",
                "preco_asc",
                "preco_desc"
              ]
            },
            "in": "query",
            "name": "ordem",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "in": "query",
            "name": "precoMin",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "in": "query",
            "name": "precoMax",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/destaques": {
      "get": {
        "summary": "Home: trabalhos em destaque, fotos rotativas e numeros da vitrine",
        "tags": [
          "Vitrine"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/fotos/tags": {
      "get": {
        "summary": "Tags mais usadas",
        "tags": [
          "Vitrine"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/fotos/{id}": {
      "get": {
        "summary": "Detalhe publico da foto",
        "tags": [
          "Vitrine"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/fotos/{id}/preview": {
      "get": {
        "summary": "Preview com marca d'agua (JPEG ate 1200 px); exige URL assinada (?e=&s=) obtida na listagem",
        "tags": [
          "Vitrine"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "query",
            "name": "e",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "in": "query",
            "name": "s",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/fotos/{id}/miniatura": {
      "get": {
        "summary": "Miniatura com marca d'agua (480 px); exige URL assinada",
        "tags": [
          "Vitrine"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "query",
            "name": "e",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "in": "query",
            "name": "s",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/eventos": {
      "get": {
        "summary": "Lista eventos ativos",
        "tags": [
          "Vitrine"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "pagina",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "tamanhoPagina",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "in": "query",
            "name": "q",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/eventos/{id}": {
      "get": {
        "summary": "Detalhe do evento",
        "tags": [
          "Vitrine"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/fotografos": {
      "get": {
        "summary": "Lista fotografos",
        "tags": [
          "Vitrine"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "pagina",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "tamanhoPagina",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "in": "query",
            "name": "q",
