{
  "name": "lenspro-server",
  "version": "2.0.0",
  "description": "API do LensPro: marketplace de fotografias (Fastify + Prisma + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/seed.js",
    "db:setup": "prisma migrate deploy && npm run build && node dist/seed.js",
    "marca-dagua": "node scripts/gerarMarcaDagua.js",
    "previews:regenerar": "node dist/regenerarPrevias.js",
    "test": "npm run build && node tests/run-all.js",
    "docs:openapi": "node dist/exportarOpenApi.js"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.6",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
