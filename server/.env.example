# Copie para .env e ajuste. Nunca versione o .env real.
DATABASE_URL="postgresql://lenspro:lenspro@localhost:5432/lenspro"
# Obrigatorio: minimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-esta-chave-por-uma-aleatoria-com-no-minimo-32-caracteres"
JWT_EXPIRES_IN="30m"
# Obrigatorio: segredo HMAC do webhook de pagamento (minimo 16 caracteres).
WEBHOOK_SECRET="troque-este-segredo-do-webhook"
# Chave AES-256 (64 hex) que cifra os originais das fotos e a chave Pix.
# Vazia = gerada automaticamente em DATA_DIR/master.key na primeira execucao.
# Em producao, injete aqui a partir de um cofre de segredos e faca backup SEPARADO.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
URL_PUBLICA="http://localhost:3000"
DATA_DIR="data"
BCRYPT_ROUNDS=12
# CORS_ORIGIN="http://localhost:5173"   (vazio = bloqueado; "*" = qualquer origem)
TAXA_PLATAFORMA_PERCENT=15
PEDIDO_EXPIRA_MIN=30
UPLOAD_MAX_MB=25
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_MIN=15
LIMITE_AUTH_POR_MINUTO=20
LOG_LEVEL="info"
SHUTDOWN_TIMEOUT_MS=10000
# Senha dos usuarios criados pelo seed (somente desenvolvimento)
# SEED_SENHA="Lenspro#2026"

# ---- Pagamento ----
# "simulado" (padrao; SO desenvolvimento, recusado com NODE_ENV=production) ou "pagseguro".
PAGAMENTO_GATEWAY="simulado"
# PagSeguro/PagBank: token da conta (sandbox ou producao) e ambiente.
# PAGSEGURO_TOKEN=""
# Id da conta PagBank dona do token (ACCO_...): recebe a taxa da plataforma no split. Obrigatorio com o PagSeguro.
# PAGSEGURO_CONTA_ID=""
# PAGSEGURO_AMBIENTE="sandbox"            # sandbox | producao
# URL publica HTTPS que o PagBank chama no webhook (ex.: https://seu-dominio/api/pagamentos/webhook/pagseguro ou tunel ngrok)
# PAGSEGURO_NOTIFICACAO_URL=""

# ---- E-mail (recuperacao de senha). Obrigatorio em producao. ----
# SMTP_URL="smtps://usuario:senha@smtp.exemplo.com:465"
# EMAIL_REMETENTE="LensPro <nao-responda@exemplo.com>"

# Expoe /docs (Swagger) mesmo em producao? Padrao: nao.
# EXPOR_DOCS="false"
